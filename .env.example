APP_ENV=development
# Development listens on 127.0.0.1 only. Set LISTEN_HOST=0.0.0.0 to reach the API
# from another device; development authentication trusts every request it receives.
# LISTEN_HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://noted:noted@localhost:5434/noted?sslmode=disable
ASSET_ROOT=.local/noted-assets
MAX_UPLOAD_BYTES=52428800
ALLOWED_ORIGIN=http://localhost:4200
AUTH_MODE=development
DEV_USER_EMAIL=learner@noted.local
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URL=
AUTH_GOOGLE_ALLOWED_EMAILS=
# Lifetime is 90 days (Dined's AUTH_SESSION_TTL default of 2160h). A longer
# SESSION_TTL is honored. Shorter values, including the retired 12h setting,
# are raised to 90 days.
# SESSION_TTL=2160h
FRONTEND_URL=http://localhost:4200
# Internal Prometheus listener for GET /metrics. Defaults to 127.0.0.1:9464 outside
# production and :9464 in production. Set off to disable.
# METRICS_ADDR=127.0.0.1:9464
# Optional comma-separated CIDRs of controlled reverse proxies allowed to provide
# X-Forwarded-For. Empty records the socket peer and ignores forwarded headers.
# TRUSTED_PROXY_CIDRS=
