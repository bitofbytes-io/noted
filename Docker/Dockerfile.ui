# syntax=docker/dockerfile:1@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183

FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS builder

WORKDIR /web

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

FROM nginx:1.31.10-alpine@sha256:7fc0fb4af7bf006aeb31aea88069976060f8f0a0a86b667126742cc17f4e31ae

ARG VERSION=dev
ARG REVISION=unknown
ARG SOURCE_URL=https://github.com/bitofbytes-io/noted

COPY Docker/ui/nginx-main.conf /etc/nginx/nginx.conf
COPY Docker/ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /web/dist/web/browser/ /usr/share/nginx/html/

# The runtime writes only PID and temporary files under /tmp.
RUN chmod -R a-w /etc/nginx /usr/share/nginx/html

LABEL org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="noted-ui" \
      org.opencontainers.image.description="Noted sheet-music binder web application"

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1

# No runtime configuration generation or privileged base-image entrypoint.
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
