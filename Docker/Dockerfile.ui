# syntax=docker/dockerfile:1

FROM node:24.22.2-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85 AS builder

WORKDIR /web

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

FROM nginx:1.29.8-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de

ARG VERSION=dev
ARG REVISION=unknown
ARG SOURCE_URL=https://github.com/bitofbytes-io/noted

COPY Docker/ui/nginx-main.conf /etc/nginx/nginx.conf
COPY Docker/ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /web/dist/web/browser/ /usr/share/nginx/html/

# The runtime writes only PID and temporary files under /tmp.
RUN chmod -R a-w /etc/nginx /usr/share/nginx/html

LABEL org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="noted-ui" \
      org.opencontainers.image.description="Noted sheet-music binder web application"

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1

# No runtime configuration generation or privileged base-image entrypoint.
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
