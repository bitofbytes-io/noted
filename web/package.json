{
  "name": "noted-web",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "prettier --check \"src/**/*.{ts,html,scss}\" && tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/platform-browser": "^21.2.23",
    "@angular/router": "^21.2.23",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/angular": "^1.26.0",
    "@techstark/opencv-js": "4.12.0-release.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.23",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
